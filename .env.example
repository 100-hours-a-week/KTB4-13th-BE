# 로컬 MySQL 전용 예시입니다. 실제 인증정보를 커밋하지 마세요.
# Gradle은 이 파일을 자동으로 읽지 않습니다. 실행 환경에 변수를 설정하세요.
DB_URL=jdbc:mysql://localhost:3306/book
DB_USERNAME=book
DB_PASSWORD=replace-with-local-password

# AI 서버 연동(검색·추천·챗봇 등 후속 기능)용 서비스 간 인증 값입니다.
# 사용자 로그인 토큰이 아니며, AI 팀과 별도로 공유받은 값을 사용하세요.
AI_BASE_URL=http://localhost:8000
AI_SERVICE_TOKEN=replace-with-shared-ai-service-token

# Sentry server-side error monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1
